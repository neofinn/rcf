# Copy to .env and fill in. Never commit .env.
PORT=3000
NODE_ENV=production
# Public URL customers use (goes into WhatsApp tracking links).
PUBLIC_BASE_URL=https://order.example.com
DB_PATH=./data/rcf.db

# Token outlet staff use to log in to /admin/. Use a long random string.
ADMIN_TOKEN=

# WhatsApp Cloud API (Meta Business > WhatsApp > API setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string; enter the same value in Meta's webhook configuration.
WHATSAPP_VERIFY_TOKEN=
# App secret, used to verify webhook signatures.
WHATSAPP_APP_SECRET=

# Shadowfax Hyperlocal (delivery riders). Leave the token empty to turn it off,
# or set SHADOWFAX_MODE=simulate to try it locally with a pretend Shadowfax.
SHADOWFAX_TOKEN=
SHADOWFAX_BASE_URL=https://hlbackend.staging.shadowfax.in
# Shared secret Shadowfax sends in the X-Callback-Token header on callbacks.
SHADOWFAX_CALLBACK_TOKEN=
# Book the rider when the outlet accepts (accepted) or starts cooking (preparing).
SHADOWFAX_BOOK_ON=accepted

# Optional pricing overrides (paise)
# PACKING_CHARGE_PAISE=1000
# MIN_DELIVERY_ORDER_PAISE=14900
# FREE_DELIVERY_ABOVE_PAISE=49900
